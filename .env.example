SHELFCASH_BACKEND_URL=http://127.0.0.1:8000
SHELFCASH_API_KEY=
SHELFCASH_STORE_ID=
# USE_MOCK_API=false

# Cấu hình dữ liệu giả định/minh họa (mock) cho phần phân tích nguyên nhân thất bại & thẩm định ràng buộc
NEXT_PUBLIC_ENABLE_DECISION_MOCK_DIAGNOSTICS=true

# Opportunity Recommendation
# disabled | preview | live
VITE_SHELFCASH_OPPORTUNITY_MODE=preview
NEXT_PUBLIC_SHELFCASH_OPPORTUNITY_MODE=preview

# Opportunity map provider: none | osm | google
# osm: OpenStreetMap + Leaflet + Nominatim + Overpass (Mặc định - không cần API key / billing)
# google: Google Maps (Tùy chọn tương lai - yêu cầu API key)
# none: Standalone fallback scanner
VITE_SHELFCASH_MAP_PROVIDER=osm
NEXT_PUBLIC_SHELFCASH_MAP_PROVIDER=osm

# Browser key cho Google Maps (Chỉ dùng khi provider=google, bỏ trống khi dùng osm)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

